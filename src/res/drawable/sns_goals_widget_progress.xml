<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="15.0dip" />
            <solid android:color="@color/sns_goals_widget_progress_background" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="bottom" android:clipOrientation="vertical">
            <shape android:shape="rectangle">
                <corners android:radius="15.0dip" />
                <gradient android:startColor="@color/sns_goals_widget_progress_loading_start" android:endColor="@color/sns_goals_widget_progress_loading_end" android:angle="90.0" />
            </shape>
        </clip>
    </item>
</layer-list>
