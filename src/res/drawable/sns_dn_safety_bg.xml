        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ff672d65" android:endColor="#ff824627" android:angle="0.0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ff90408e" android:endColor="#ff9f5631" android:angle="0.0" />
        </shape>
    </item>
</selector>
