<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="8.0dip" />
            <solid android:color="@color/sns_levels_info_item_icon_background_viewer_gifts" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="8.0dip" />
                <gradient android:startColor="@color/sns_levels_progress_bar_start_color" android:endColor="@color/sns_levels_progress_bar_end_color" android:angle="0.0" android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
