<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:id="@id/state_on" android:drawable="@drawable/sns_ic_menu_overflow_selected" />
    <item android:id="@id/state_off" android:drawable="@drawable/sns_ic_menu_overflow_default" />
    <transition android:drawable="@drawable/sns_ic_menu_overflow_avd_on" android:toId="@id/state_on" android:fromId="@id/state_off" />
    <transition android:drawable="@drawable/sns_ic_menu_overflow_avd_off" android:toId="@id/state_off" android:fromId="@id/state_on" />
</animated-selector>
