<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ff8069b4" android:endColor="#ff54aea4" android:angle="0.0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <gradient android:startColor="#ff8a6fcc" android:endColor="#ff6adace" android:angle="0.0" />
        </shape>
    </item>
</selector>
