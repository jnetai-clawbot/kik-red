<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:constantSize="true" android:shape="rectangle">
            <corners android:radius="@dimen/sns_gender_filter_button_radius" />
            <solid android:color="@color/sns_gender_filter_color_selected" />
        </shape>
    </item>
    <item android:state_checked="false" android:state_pressed="true">
        <shape android:constantSize="true" android:shape="rectangle">
            <corners android:radius="@dimen/sns_gender_filter_button_radius" />
            <solid android:color="@color/sns_gender_filter_color_pressed" />
        </shape>
    </item>
    <item>
        <shape android:constantSize="true" android:shape="rectangle">
            <corners android:radius="@dimen/sns_gender_filter_button_radius" />
            <solid android:color="@color/sns_gender_filter_color_not_selected" />
        </shape>
    </item>
</selector>
