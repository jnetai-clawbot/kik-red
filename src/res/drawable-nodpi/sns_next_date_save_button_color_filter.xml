<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape android:constantSize="true" android:shape="rectangle">
            <corners android:radius="@dimen/sns_pill_button_corner_radius" />
            <solid android:color="@color/sns_button_color_blue" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:constantSize="true" android:shape="rectangle">
            <corners android:radius="@dimen/sns_pill_button_corner_radius" />
            <solid android:color="@color/gray_bb" />
        </shape>
    </item>
    <item>
        <shape android:constantSize="true" android:shape="rectangle">
            <corners android:radius="@dimen/sns_pill_button_corner_radius" />
            <solid android:color="@color/sns_button_color_blue" />
        </shape>
    </item>
</selector>
